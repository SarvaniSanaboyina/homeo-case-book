# Copy this file to .env, then replace the placeholders with your real values.
# Nothing in this file is a live secret.

# Neon → your project → Connect → copy the pooled connection string.
# The host should contain `-pooler`. Keep sslmode=require.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# true for Neon. Set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Local API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional. In development the app talks to http://localhost:4000/api.
# Leave this unset on Vercel so the site uses same-origin /api.
# VITE_API_URL=http://localhost:4000/api

# --- Vercel (Project → Settings → Environment Variables) ---
# Production and Preview:
#   DATABASE_URL     required   Neon pooled URI (same as above)
#   DATABASE_SSL     optional   true
#   CORS_ORIGIN      optional   https://your-app.vercel.app
# Do not set VITE_API_URL on Vercel.
# Do not set PORT on Vercel.
# Never add .env to git.
