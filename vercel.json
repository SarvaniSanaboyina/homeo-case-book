{
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
